  "domain": "security",
  "category": "monitoring",
  "intent_pattern": "监控|告警|攻击|威胁|入侵|异常|安全",
  "sample_inputs": [
    "检查有没有异常登录",
    "最近有哪些安全告警",
    "有入侵检测吗",
    "查看安全态势",
    "封禁可疑IP"
  ],
  "intent_vector": {
    "urgency": 0.9,
    "complexity": 0.7,
    "autonomy": 0.9,
    "cooperation": 0.2,
    "risk_tolerance": 0.1,
    "domain": "security"
  },
  "tasks": [
    {
      "id": "sec_task_1",
      "name": "事件采集",
      "description": "从各数据源采集安全事件",
      "sequence": 1,
      "dependencies": [],
      "estimated_time": "<100ms",
      "sources": ["firewall", "ids", "logs", "auth"]
    },
    {
      "id": "sec_task_2",
      "name": "威胁检测",
      "description": "使用规则和AI检测威胁",
      "sequence": 2,
      "dependencies": ["sec_task_1"],
      "estimated_time": "<500ms",
      "methods": ["rule_based", "ml_anomaly"]
    },
    {
      "id": "sec_task_3",
      "name": "风险评估",
      "description": "评估威胁严重程度",
      "sequence": 3,
      "dependencies": ["sec_task_2"],
      "estimated_time": "<200ms",
      "levels": ["critical", "high", "medium", "low"]
