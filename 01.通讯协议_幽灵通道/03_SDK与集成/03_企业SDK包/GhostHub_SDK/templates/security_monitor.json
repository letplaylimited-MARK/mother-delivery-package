    {
      "id": "sec_task_4",
      "name": "自动响应",
      "description": "执行预设的响应动作",
      "sequence": 4,
      "dependencies": ["sec_task_3"],
      "estimated_time": "<1s",
      "actions": ["block_ip", "disable_account", "notify", "escalate"]
