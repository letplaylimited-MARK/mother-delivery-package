FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "cryptography>=41.0.0"

COPY 02_开源社区包/ghost_channel开源库/src/ghost_channel /app/python/ghost_channel
COPY 04_SDK工程包/ghost-channel-sdk/python/ghost_channel_sdk /app/python/ghost_channel_sdk
COPY 04_SDK工程包/ghost-channel-sdk/schemas/ /app/schemas/
COPY 04_SDK工程包/ghost-channel-sdk/examples/ /app/examples/
COPY 04_SDK工程包/ghost-channel-sdk/stress_test_100_concurrent.py /app/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/python

CMD ["python", "-u", "stress_test_100_concurrent.py"]
