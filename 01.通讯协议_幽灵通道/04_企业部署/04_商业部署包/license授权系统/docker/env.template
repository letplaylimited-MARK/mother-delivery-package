# ============================================================
# Ghost Channel License Server - Environment Configuration Template
# 幽灵通道授权服务器 - 环境配置模板
#
# 复制此文件为 .env 并填写实际值
#
# AI管理说明:
# 1. 读取此文件获取配置项
# 2. SECRET_KEY 是必需项，生成方式: python -c "import secrets; print(secrets.token_hex(32))"
# 3. 敏感信息通过环境变量传入，不要硬编码
# ============================================================

# ============ 必填配置 ============

# 服务器密钥 (必需)
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_secret_key_here

# ============ 服务器配置 ============

# 运行环境: development / staging / production
APP_ENV=production

# 服务端口
SERVER_PORT=8001

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ Redis配置 (可选) ============

# Redis主机
REDIS_HOST=redis

# Redis端口
REDIS_PORT=6379

# Redis密码 (如果有)
REDIS_PASSWORD=

# ============ CORS配置 ============

# 允许的来源 (* = 全部)
CORS_ORIGINS=*

# ============ 域名配置 (生产环境) ============

# 服务器域名
DOMAIN=license.ghost-channel.io

# ============ SSL配置 (生产环境) ============

# 启用SSL
SSL_ENABLED=false

# SSL证书路径
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# ============ 监控配置 ============

# 启用Prometheus指标
ENABLE_METRICS=true

# 指标端点路径
METRICS_PATH=/metrics

# ============ 安全配置 ============

# API请求超时 (秒)
API_TIMEOUT=30

# 最大请求大小 (MB)
MAX_REQUEST_SIZE=10

# ============ 数据库配置 (可选) ============

# 使用SQLite (默认)
DB_TYPE=sqlite
DB_PATH=/app/data/licenses.db

# 使用PostgreSQL (可选)
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ghost_license
# DB_USER=ghost
# DB_PASSWORD=

# ============ 邮件配置 (可选) ============

# SMTP服务器
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=

# 通知邮箱
NOTIFICATION_EMAIL=admin@example.com
